{
    "name": "k-kinzal/magix-cache",
    "description": "MagixCache is a PSR-compatible cacheability propagation library for PHP 8.5",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/k-kinzal/magix-cache",
    "authors": [
        {
            "name": "k-kinzal",
            "homepage": "https://github.com/k-kinzal"
        }
    ],
    "support": {
        "issues": "https://github.com/k-kinzal/magix-cache/issues",
        "source": "https://github.com/k-kinzal/magix-cache"
    },
    "keywords": [
        "cache",
        "cacheability",
        "php-8.5"
    ],
    "require": {
        "php": "^8.5",
        "psr/cache": "^3.0",
        "psr/clock": "^1.0",
        "psr/simple-cache": "^3.0"
    },
    "provide": {
        "psr/clock-implementation": "1.0"
    },
    "autoload": {
        "psr-4": {
            "Magix\\Cache\\": "src/"
        }
    }
}
