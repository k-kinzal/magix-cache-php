includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/k-kinzal/php-ai-toolkit/extension.neon
    - vendor/k-kinzal/php-ai-toolkit/error-formatter.neon

parameters:
    level: max
    phpVersion: 80300
    exceptions:
        implicitThrows: false
        check:
            missingCheckedExceptionInThrows: true
            tooWideThrowType: true
        uncheckedExceptionClasses:
            - LogicException
            - RuntimeException
            - Error
            - Random\RandomException
            - PHPUnit\Framework\MockObject\Exception
    stubFiles:
        - phpstan-stubs/serialize.stub
    customRules:
        broadCatchAllowedPaths:
            # Boundaries where the failure arrives from code this library does
            # not own, so its hierarchy cannot be constrained. Each one hands
            # the failure to an explicit classifier instead of deciding alone.
            #
            # serialize() reports an argument it refuses with a bare \Exception,
            # which this adapter turns into the concrete type its key contract
            # declares. An Error still escapes: that is the caller's bug.
            - '*/packages/magix-cache/src/Runtime/KeyStrategy/HashCacheKeyStrategy.php'
        restrictedTestNamespacePrefixes:
            - 'Tests\Unit'
            - 'Tests\Integration'
            - 'Tests\Package\Laravel\Unit'
            - 'Tests\Package\Symfony\Unit'
            - 'Tests\Package\Cli\Unit'
    paths:
        - packages
    tmpDir: .phpstan.cache
