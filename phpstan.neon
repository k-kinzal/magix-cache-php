includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/k-kinzal/php-ai-toolkit/extension.neon
    - vendor/k-kinzal/php-ai-toolkit/error-formatter.neon

parameters:
    level: max
    exceptions:
        implicitThrows: false
        check:
            missingCheckedExceptionInThrows: true
            tooWideThrowType: true
        uncheckedExceptionClasses:
            - LogicException
            - RuntimeException
            - Error
            - Random\RandomException
            - PHPUnit\Framework\MockObject\Exception
    stubFiles:
        - phpstan-stubs/serialize.stub
    customRules:
        broadCatchAllowedPaths:
            # Boundaries where the failure arrives from code this library does
            # not own, so its hierarchy cannot be constrained. Each one hands
            # the failure to an explicit classifier instead of deciding alone.
            #
            # serialize() reports an argument it refuses with a bare \Exception,
            # which this adapter turns into the concrete type its key contract
            # declares. An Error still escapes: that is the caller's bug.
            - '*/packages/magix-cache/src/Runtime/KeyStrategy/HashCacheKeyStrategy.php'
            # The origin closure is caller code: a PSR-18 client, Doctrine DBAL,
            # or a JsonException all sit outside the RuntimeException family.
            - '*/packages/magix-cache/src/Runtime/Strategy/StaleIfErrorCacheStrategy.php'
            # A Cache implementation may be third party and is not obliged to
            # report failures as CacheBackendFailure.
            - '*/packages/magix-cache/src/Runtime/Strategy/BypassCacheErrorsStrategy.php'
        restrictedTestNamespacePrefixes:
            - 'Tests\Unit'
            - 'Tests\Integration'
            - 'Tests\Package\Laravel\Unit'
            - 'Tests\Package\Symfony\Unit'
            - 'Tests\Package\Cli\Unit'
    paths:
        - packages
    tmpDir: .phpstan.cache
    ignoreErrors:
        # A pass-through boundary rethrows the caller's own exception unchanged;
        # that is its specification, because wrapping would take away the type
        # the caller wants to catch. The only honest tag for that is
        # "@throws \Throwable", so customRules.genericThrowsTag cannot hold
        # here. The catch itself stays declared in broadCatchAllowedPaths.
        -
            identifier: customRules.genericThrowsTag
            path: packages/magix-cache/src/Runtime/Strategy/StaleIfErrorCacheStrategy.php
        -
            identifier: customRules.genericThrowsTag
            path: packages/magix-cache/src/Runtime/Strategy/BypassCacheErrorsStrategy.php
