includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/k-kinzal/php-ai-toolkit/extension.neon
    - vendor/k-kinzal/php-ai-toolkit/error-formatter.neon

parameters:
    level: max
    phpVersion: 80300
    exceptions:
        implicitThrows: false
        check:
            missingCheckedExceptionInThrows: true
            tooWideThrowType: true
        uncheckedExceptionClasses:
            - LogicException
            - RuntimeException
            - Error
            - Random\RandomException
            - PHPUnit\Framework\MockObject\Exception
    stubFiles:
        - phpstan-stubs/serialize.stub
        - phpstan-stubs/promise.stub
    ignoreErrors:
        # Promise validation is an invariant of AsyncCached itself. Exposing
        # this implementation check or moving it to a public collaborator
        # would add an unrelated API solely to satisfy method visibility.
        -
            identifier: customRules.nonPublicMethod
            path: packages/magix-cache/src/AsyncCached.php
            count: 1
        # flatten registers validation inside a continuation. The rejection
        # is surfaced only when this async result is synchronized.
        -
            identifier: throws.unusedType
            path: packages/magix-cache/src/AsyncCached.php
            count: 1
        # fetch registers the documented RuntimeException rethrow as an
        # asynchronous rejection callback; it is observable on wait().
        -
            identifier: throws.unusedType
            path: packages/magix-cache/src/Strategy/StaleIfErrorCacheStrategy.php
            count: 1
        # Attribute repeatability is public PHP behavior, enforced only when
        # ReflectionAttribute::newInstance() materializes the declarations.
        # This regression test reads public attributes, never private state;
        # direct constructor calls cannot detect a missing IS_REPEATABLE flag.
        -
            identifier: customRules.noReflectionInTestClass
            message: '#^Replace ReflectionMethod usage with assertions against public behavior\. Test classes must not use Reflection\.$#'
            path: packages/magix-cache/tests/Unit/Strategy/Contract/ExpiresAtTest.php
            count: 1
    customRules:
        broadCatchAllowedPaths:
            # Boundaries where the failure arrives from code this library does
            # not own, so its hierarchy cannot be constrained. Each one hands
            # the failure to an explicit classifier instead of deciding alone.
            #
            # serialize() reports an argument it refuses with a bare \Exception,
            # which this adapter turns into the concrete type its key contract
            # declares. An Error still escapes: that is the caller's bug.
            - '*/packages/magix-cache/src/Runtime/KeyStrategy/HashCacheKeyStrategy.php'
        restrictedTestNamespacePrefixes:
            - 'Tests\Unit'
            - 'Tests\Integration'
            - 'Tests\Package\Laravel\Unit'
            - 'Tests\Package\Symfony\Unit'
            - 'Tests\Package\Cli\Unit'
    paths:
        - packages
        - bench
    tmpDir: .phpstan.cache
